{
  "name": "smart-album-studio",
  "version": "1.0.0",
  "description": "A macOS photo album workflow for wedding and event photographers",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging",
    "dist:mac": "electron-builder --mac dmg --x64 --publish never"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "konva": "10.9.1",
    "pdf-lib": "1.17.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "electron": "37.5.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.lucidlenz.smartalbumstudio",
    "productName": "SmartAlbum Studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "styles/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "artifactName": "SmartAlbum-Studio-${version}-Intel.dmg"
    }
  }
}
